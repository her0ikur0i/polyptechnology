{
  "name": "polyp-ai-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch src/control-api/server.ts",
    "start": "tsx src/control-api/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'tests/*.test.ts'",
    "verify": "npm run typecheck && npm test && npm run dashboard:test && npm run dashboard:build",
    "contract:verify": "node --import tsx scripts/verify-contract.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dashboard:dev": "vite",
    "dashboard:build": "vite build",
    "dashboard:test": "vitest run"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "lucide-react": "1.30.0",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "axe-core": "4.13.0",
    "jsdom": "30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
