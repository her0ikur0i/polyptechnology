[Unit]
Description=Polyp AI Factory sequence controller
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=notify
# Node cannot send a unix datagram without a native module, so readiness and
# watchdog pings go through /usr/bin/systemd-notify -- a child process. With the
# default NotifyAccess=main, systemd rejects those with "reception only
# permitted for main PID" and the unit never becomes ready, then start times
# out. This is the documented setting for notifications sent by helper
# processes.
#
# The trade-off, stated rather than glossed: any process in this cgroup can now
# send notifications, including the provider CLIs this service spawns. In a
# trust model where we already execute those CLIs' output behind an approval
# gate, a forged WATCHDOG=1 is a marginal escalation -- but it is a real one,
# and the alternative was dropping the watchdog entirely from a long-running
# worker, which is worse.
NotifyAccess=all
# Runs as root, at the owner's explicit instruction (2026-08-10).
#
# The assistant reachable from Telegram is meant to be genuinely capable, which
# means reading and changing this repository. The repository lives under /root,
# which is mode 0700 -- an unprivileged service user cannot even traverse into
# it, so tools would have been decoration.
#
# Stated plainly rather than buried: the provider CLI now runs as root with
# tools enabled and permission prompts bypassed. Anything the owner can be
# talked into asking for, the assistant can do. The owner made that call for a
# single-owner controlled machine after the trade-off was put to them directly.
# Reverting is a two-line change here plus ASSISTANT_TOOLS in sequence.env.
User=root
WorkingDirectory=/opt/polyp-ai-factory/current
EnvironmentFile=/etc/polyp-ai-factory/sequence.env
ExecStartPre=/usr/bin/node dist/src/operations/readiness-main.js
ExecStart=/usr/bin/node dist/src/orchestrator/sequence-main.js
Restart=on-failure
RestartSec=10s
WatchdogSec=45s
TimeoutStopSec=30s
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectSystem=strict
# Off: the repository the assistant works in lives under /root.
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# Turned OFF, deliberately, after it broke a real run.
#
# MemoryDenyWriteExecute forbids writable-executable mappings, which is
# incompatible with a V8 JIT. The workaround was --jitless, and --jitless also
# disables WebAssembly -- the supervisor then died mid-run with
# "ReferenceError: WebAssembly is not defined" immediately after producing a
# real reply. Neither the flag nor the workaround survives contact with a Node
# workload that spawns Node children.
#
# The reasoning for accepting this: this unit runs *our* code. Untrusted
# AI-authored code never executes here -- it runs in the Docker sandbox
# (src/worker/planner.ts) with --read-only, --cap-drop=ALL, --network=none and
# its own limits. Hardening the wrong process at the cost of the service
# running at all is not a security win.
MemoryDenyWriteExecute=false
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/polyp-ai-factory /var/log/polyp-ai-factory /root/polyptechnology-next
# Raised from 512M: this process spawns provider CLIs as child processes, and
# a child Node runtime counts against the same cgroup. 512M killed the parent
# before the child could answer.
MemoryMax=1500M
CPUQuota=100%
# Raised from 64 on 2026-08-11, after measuring rather than guessing.
#
# 64 was one task short of a single Codex call. `codex exec` is a Rust binary
# with a threaded async runtime: one call, measured in its own scope, peaks at
# **57 tasks**. This supervisor idles at 11. 11 + 57 is past 64, so the cgroup
# ran out of task slots partway through every Codex attempt, and the next
# fork(2) in the process returned EAGAIN.
#
# What forked next was the watchdog ping, and `spawn()` failing raised an
# unhandled 'error' event that killed the supervisor outright:
#
#   Error: spawn /usr/bin/systemd-notify EAGAIN
#
# The process died mid-attempt, so the gateway attempt in flight stayed
# `dispatched` with no verdict, the lease expired ~40s later, and the work
# engine burned the next attempt on the same dead end. That is the whole
# explanation for the 20 stranded Codex attempts on staging holding $10.00 in
# reservations -- and for why the escalation chain never reached its last tier.
#
# 512 is not a capacity plan; MemoryMax is the real resource bound here. It is
# a fork-bomb ceiling with room for a Codex call, a Docker verify, and the
# ordinary Node children to coexist without any of them starving a fork the
# process needs to stay alive.
TasksMax=512
StateDirectory=polyp-ai-factory
LogsDirectory=polyp-ai-factory
UMask=0077

[Install]
WantedBy=multi-user.target
